# ─────────────────────────────────────────────────────────────
# HireShield — environment variables
# Copy this file to `.env` (or set the same keys in your host's
# secret manager) and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────

# PostgreSQL connection string used by Drizzle ORM.
# Example: postgres://user:password@host:5432/hireshield
DATABASE_URL=

# OpenAI-compatible endpoint used by the analyzer.
# On Replit, the AI Integrations proxy provides these automatically.
# For self-hosting you can point this at OpenAI directly:
#   AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
#   AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# ── Optional ────────────────────────────────────────────────

# Apify API token. Enables the JS-rendered page scraping fallback
# for the /analyze URL mode (Website Content Crawler actor).
# Without it, only plain HTML pages can be fetched from a URL —
# paste-text mode always works.
# Get one at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Random string used to sign sessions. Any value works locally.
SESSION_SECRET=

# Log level for the API server: trace | debug | info | warn | error
LOG_LEVEL=info
