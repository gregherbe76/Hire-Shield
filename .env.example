# ─────────────────────────────────────────────────────────────
# HireShield — environment variables
# Copy this file to `.env` (or set the same keys in your host's
# secret manager) and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────

# PostgreSQL connection string used by Drizzle ORM.
# Example: postgres://user:password@host:5432/hireshield
DATABASE_URL=

# OpenAI-compatible endpoint used by the analyzer.
# On Replit, the AI Integrations proxy provides these automatically.
# For self-hosting you can point this at OpenAI directly:
#   AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
#   AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# ── Optional ────────────────────────────────────────────────

# Apify API token. Enables the JS-rendered page scraping fallback
# for the /analyze URL mode (Website Content Crawler actor).
# Without it, only plain HTML pages can be fetched from a URL —
# paste-text mode always works.
# Get one at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Random string used to sign sessions. Any value works locally.
SESSION_SECRET=

# Log level for the API server: trace | debug | info | warn | error
LOG_LEVEL=info

# Number of upstream proxy hops to trust for X-Forwarded-For. Default 1
# (the Replit shared proxy or typical single CDN). Increase if you run
# behind multiple proxies. Set to "false" to disable proxy trust.
# Wrong values weaken per-IP rate limiting (attackers can spoof headers).
TRUST_PROXY=1

# ── Rate limiting (POST /api/analyses) ──────────────────────
# Each analysis triggers an OpenAI call, so the public endpoint is
# rate-limited to bound spend and prevent abuse. Set any value to 0
# to disable that specific limit. Limits are tracked in memory per
# server process; for multi-instance deployments put a CDN / WAF
# (or a Redis-backed limiter) in front instead.

# Max analyses per IP per rolling hour.
RATE_LIMIT_PER_IP_HOURLY=10

# Max analyses per IP per rolling day.
RATE_LIMIT_PER_IP_DAILY=30

# Global daily cap across all IPs — acts as a circuit breaker for
# OpenAI spend. Once tripped, the API returns 429 until the day rolls
# over.
RATE_LIMIT_GLOBAL_DAILY=500
